theorem certificate_count : certificates.length = 250 := by decide
theorem all_certificates_valid : certificates.all checkCertificate = true := by native_decide
theorem all_certificates_bad (c : Certificate) (hc : c ∈ certificates) :
    BAD (graphOfEdges c.edges) (firstBoundary c.large) := by
  exact checker_sound c ((List.all_eq_true.mp all_certificates_valid) c hc)

