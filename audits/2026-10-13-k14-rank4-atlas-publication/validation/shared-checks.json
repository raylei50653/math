[
  {
    "name": "docs",
    "command": [
      "python3",
      "scripts/check_docs.py"
    ],
    "exit_code": 1,
    "log": "docs.log"
  },
  {
    "name": "docgraph-formal",
    "command": [
      "python3",
      "tools/docgraph",
      "--include",
      "docs/**/*.md",
      "check"
    ],
    "exit_code": 0,
    "log": "docgraph-formal.log"
  },
  {
    "name": "docgraph-global",
    "command": [
      "python3",
      "tools/docgraph",
      "check"
    ],
    "exit_code": 1,
    "log": "docgraph-global.log"
  },
  {
    "name": "diff",
    "command": [
      "git",
      "diff",
      "--check"
    ],
    "exit_code": 0,
    "log": "diff.log"
  },
  {
    "name": "docs-final",
    "command": [
      "python3",
      "scripts/check_docs.py"
    ],
    "exit_code": 0,
    "log": "docs-final.log"
  }
]
