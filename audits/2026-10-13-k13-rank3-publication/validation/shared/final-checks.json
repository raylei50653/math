{
  "final-docs": {
    "command": [
      "python3",
      "-B",
      "scripts/check_docs.py"
    ],
    "exit_code": 0,
    "stdout": "final-docs.stdout.log",
    "stderr": "final-docs.stderr.log"
  },
  "final-formal-docgraph": {
    "command": [
      "python3",
      "-B",
      "tools/docgraph",
      "--include",
      "docs/**/*.md",
      "check"
    ],
    "exit_code": 0,
    "stdout": "final-formal-docgraph.stdout.log",
    "stderr": "final-formal-docgraph.stderr.log"
  },
  "final-storage": {
    "command": [
      "python3",
      "-B",
      "tools/check_generated_artifacts.py"
    ],
    "exit_code": 0,
    "stdout": "final-storage.stdout.log",
    "stderr": "final-storage.stderr.log"
  },
  "final-whitespace": {
    "command": [
      "git",
      "diff",
      "--cached",
      "--check"
    ],
    "exit_code": 0,
    "stdout": "final-whitespace.stdout.log",
    "stderr": "final-whitespace.stderr.log"
  }
}
