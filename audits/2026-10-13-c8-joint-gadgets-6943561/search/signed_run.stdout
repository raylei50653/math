 ignore all boundary chords. hN.signatures.u8.gz stores one byte per graph and row: bit j=1 exactly when endpoints of lexicographically sorted chord j have equal colors. A signed cap fibre is the raw full fibre if this byte equals its Eq mask, and empty otherwise. All original private edges and spokes retain Diff.", "full_lifts_ignoring_chords": 204250566, "empty_fibres_ignoring_chords": 23025110, "forced_rows": {"c04-941": [], "c07-941": [], "c15-933": [19, 33, 188, 249], "c15-941": [], "c18-933": [44, 67, 157, 188], "c18-941": [], "c20-941": [], "c30-941": []}, "minimum_intersections": {"c04-941": 2, "c07-941": 2, "c15-933": 1, "c15-941": 3, "c18-933": 1, "c18-941": 2, "c20-941": 3, "c30-941": 2}}
